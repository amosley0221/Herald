{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herald",
  "version": "0.1.0",
  "identifier": "design.herald.desktop",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Herald",
        "width": 1120,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0C0A09",
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://* http://*"
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Automated job application engine",
    "longDescription": "Herald reads every posting published today against your resume and brings you only the ones worth your time.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": false
  },

  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "",
      "endpoints": [
        "https://amosley0221.github.io/herald/releases/latest.json"
      ]
    }
  }
}
