{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The minimum the Herald window needs: open a link, check for an update, relaunch into it, and -- when it is doing its own scanning -- reach job boards, keep a database, and hold a key.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "updater:default",
    "process:allow-restart",
    "store:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://boards-api.greenhouse.io/*" },
        { "url": "https://api.lever.co/*" },
        { "url": "https://api.ashbyhq.com/*" },
        { "url": "https://*.myworkdayjobs.com/*" },
        { "url": "https://raw.githubusercontent.com/*" },
        { "url": "https://github.com/*" }
      ]
    }
  ]
}
