{
  "server": { "host": "0.0.0.0", "port": 8787 },
  "storage": { "dataDir": "./data" },
  "schedule": {
    "crawlCron": "0 * * * *",
    "trackCron": "*/30 * * * *",
    "crawlOnBoot": false,
    "enabled": true
  },
  "llm": {
    "scoreModel": "claude-sonnet-5",
    "writeModel": "claude-sonnet-5",
    "concurrency": 4,
    "maxScoresPerCrawl": 400,
    "promptDir": "./config/prompts"
  },
  "matching": { "feedFloor": 60, "initialLookbackHours": 48, "maxPostingAgeDays": 30 },
  "apply": {
    "enabled": true,
    "headless": true,
    "manualOnlyHosts": ["linkedin.com", "www.linkedin.com"],
    "screenshotConfirmations": true,
    "fieldRulesFile": "./config/field-rules.json"
  },
  "notifications": { "enabled": true, "provider": "fcm", "fcmServiceAccountFile": null },
  "tracking": { "enabled": false, "provider": "none", "gmailLabel": "Herald" },
  "releases": { "indexUrl": null, "cacheMinutes": 30 },
  "logging": { "level": "info" },
  "sources": []
}
