{
  "name": "@herald/engine",
  "version": "0.2.6",
  "private": true,
  "description": "Herald engine — ingests postings, scores them against the resume, prepares and submits applications.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/test/**/*.test.js'",
    "init": "node dist/cli/init.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@herald/core": "*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.0",
    "fastify": "^5.6.1",
    "mammoth": "^1.12.0",
    "playwright": "^1.56.0",
    "unpdf": "^1.3.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  }
}
