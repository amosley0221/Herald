# Herald engine — environment.
# Every value here is optional except ANTHROPIC_API_KEY; the rest override
# whatever is in herald.config.json.

# Required: scoring, cover letters and resume parsing all need this.
ANTHROPIC_API_KEY=

# Bearer token the apps use. Generated by `npm run init -w @herald/engine`.
# Setting it here takes precedence over the config file.
HERALD_TOKEN=

# Where the config file lives, if not ./herald.config.json
# HERALD_CONFIG=/etc/herald/herald.config.json

# HERALD_HOST=0.0.0.0
# HERALD_PORT=8787
# Public URL the phone reaches — goes into the pairing QR code.
# HERALD_PUBLIC_URL=https://herald.example.com
# HERALD_DATA_DIR=./data

# HERALD_CRAWL_CRON=0 * * * *
# HERALD_CRAWL_ON_BOOT=false
# HERALD_SCHEDULE_ENABLED=true

# HERALD_SCORE_MODEL=claude-sonnet-5
# HERALD_WRITE_MODEL=claude-sonnet-5
# HERALD_LLM_CONCURRENCY=4
# HERALD_MAX_SCORES_PER_CRAWL=400

# HERALD_APPLY_ENABLED=true
# HERALD_APPLY_HEADLESS=true

# HERALD_FCM_SERVICE_ACCOUNT=./secrets/fcm-service-account.json
# HERALD_RELEASES_INDEX_URL=https://amosley0221.github.io/herald/releases/index.json
# HERALD_LOG_LEVEL=info

# Tokens referenced by a source's auth.tokenEnv go here too, e.g.
# CUSTOM_BOARD_TOKEN=
